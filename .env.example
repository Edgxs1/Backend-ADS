# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.

NODE_ENV=development
PORT=4000

# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave de Supabase. Usa la anon key si vas a exponer el backend a usuarios
# finales (respeta RLS). Usa la service/secret key SOLO para tareas de
# administracion y nunca la expongas en el cliente.
SUPABASE_ANON_KEY=tu-clave-de-supabase
