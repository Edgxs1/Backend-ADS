# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.

NODE_ENV=development
PORT=4000

# Origen permitido por CORS (frontend). Por defecto http://localhost:3000
FRONTEND_URL=http://localhost:3000

# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publica (anon/publishable). Se usa en createSupabaseClient() junto al JWT
# del usuario para que PostgreSQL aplique las politicas RLS.
SUPABASE_ANON_KEY=tu-anon-key

# Clave secreta (service role). SOLO tareas administrativas que deban saltar RLS
# (signInWithOtp, asignar usuarios, etc.). Nunca se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Salt secreto para los hashes criptograficos de las firmas (SHA-256) de las
# estimaciones autorizadas. Minimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA lo subas al repositorio ni lo expongas al cliente.
FIRMA_SALT=pon-aqui-un-salt-aleatorio-de-32-caracteres-minimo
